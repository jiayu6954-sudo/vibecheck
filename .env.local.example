# VibeCheck Environment Variables Configuration

# ═══════════════════════════════════════════════════════════
# AI PROVIDER CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Choose AI provider: 'claude' or 'deepseek'
#
# Recommendation:
# - China (Aliyun): AI_PROVIDER=deepseek (stable, cheap, no proxy needed)
# - Overseas (Vercel): AI_PROVIDER=claude (best quality)
# - Local Dev: AI_PROVIDER=claude (with proxy)
AI_PROVIDER=claude

# ═══════════════════════════════════════════════════════════
# CLAUDE API CONFIGURATION (for Vercel & Local Dev)
# ═══════════════════════════════════════════════════════════
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ═══════════════════════════════════════════════════════════
# DEEPSEEK API CONFIGURATION (for Aliyun China)
# ═══════════════════════════════════════════════════════════
# Get your API key from: https://platform.deepseek.com/
# Cost: ~50x cheaper than Claude
# Stability: Excellent in China mainland
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ═══════════════════════════════════════════════════════════
# SUPABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ═══════════════════════════════════════════════════════════
# DEPLOYMENT ENVIRONMENT
# ═══════════════════════════════════════════════════════════
NODE_ENV=production
PORT=3000
